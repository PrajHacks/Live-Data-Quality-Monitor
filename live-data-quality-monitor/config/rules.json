    "product_name"
  ],
  "ranges": {
    "energy_100g": {
      "min": 0,
      "max": 3800
    },
    "sugars_100g": {
      "min": 0,
      "max": 100
    },
    "fat_100g": {
      "min": 0,
      "max": 100
    },
    "salt_100g": {
      "min": 0,
      "max": 100
    }
  },
  "allowed_nutrition_grades": [
